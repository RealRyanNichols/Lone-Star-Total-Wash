lonestartotalwash.com {
    redir https://www.lonestartotalwash.com{uri} permanent
}

www.lonestartotalwash.com, lonestar.165-227-248-110.sslip.io {
    encode zstd gzip

    @blocked path /.env* /.git* /deployment/* /src/* /scripts/*
    respond @blocked 404

    reverse_proxy 127.0.0.1:3107 {
        header_up X-Real-IP {remote_host}
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}
